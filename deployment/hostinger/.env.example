APP_NAME="Golden Friendship Lodge"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gfmasoniclodge40.org
FRONTEND_URL=https://gfmasoniclodge40.org
FRONTEND_ALLOWED_ORIGINS=https://gfmasoniclodge40.org
SANCTUM_STATEFUL_DOMAINS=gfmasoniclodge40.org
APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_HOSTINGER_DATABASE
DB_USERNAME=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD="YOUR_DATABASE_PASSWORD"
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Replace uXXXXX with the account username/path shown in File Manager or SSH.
MEDIA_PUBLIC_ROOT=/home/uXXXXX/domains/gfmasoniclodge40.org/public_html/storage
MEDIA_PUBLIC_URL=https://gfmasoniclodge40.org/storage
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=15
MAIL_USERNAME=applications@gfmasoniclodge40.org
MAIL_PASSWORD="YOUR_MAILBOX_PASSWORD"
MAIL_FROM_ADDRESS=applications@gfmasoniclodge40.org
MAIL_FROM_NAME="Golden Friendship Lodge"
APPLICATION_NOTIFICATION_EMAIL=YOUR_ADMIN_RECIPIENT_EMAIL

# Initial accounts; replace passwords privately before seeding.
LODGE_ADMIN_1_USERNAME=worshipfulmasterRJMahilum
LODGE_ADMIN_1_PASSWORD=
